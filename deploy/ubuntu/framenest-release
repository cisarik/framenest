#!/usr/bin/env fish

set -l script_dir (dirname (status filename))
set -l engine "$script_dir/framenest_release.py"

if not test -f "$engine"
    echo "FrameNest release engine is unavailable." >&2
    exit 1
end

set -l repo_root (git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)
if test $status -ne 0
    echo "FrameNest repository root could not be resolved." >&2
    exit 1
end

set -l python "$repo_root/.venv/bin/python"
if not test -x "$python"
    echo "FrameNest repository .venv Python is unavailable." >&2
    exit 1
end

command "$python" "$engine" $argv
exit $status
