#!/bin/bash
# FrameNest catalog export launcher (repository source for host install).
#
# Installed host path (later provisioning only):
#   /usr/local/libexec/framenest-catalog-export-v1
#
# Required installed ownership/mode (later host provisioning):
#   owner root:root
#   mode 0755 (executable; not writable by operator or framenest)
#   parent directory root-controlled
#
# Contract:
#   - zero accepted arguments (explicit rejection otherwise)
#   - umask 077
#   - stdin unused (closed)
#   - stdout reserved exclusively for protocol-v1 export bytes
#   - stderr reserved for bounded sanitized diagnostics
#   - fixed absolute FrameNest export CLI path
#   - no caller-provided command, release path, or environment inheritance
#   - does not embed workstation paths, credentials, or operator usernames
#
# Run-as identity is framenest via a narrow sudoers rule; this launcher must
# not be invoked as root for product export.

set -eu

umask 077

if [ "$#" -ne 0 ]; then
  printf '%s\n' "framenest-catalog-export-v1 rejects all arguments." >&2
  exit 2
fi

# Close stdin; protocol bytes use stdout only.
exec </dev/null

readonly FRAMENEST_BACKUP_BIN="/opt/framenest/current/.venv/bin/framenest-backup"
readonly FRAMENEST_WORKDIR="/opt/framenest/current"

if [ ! -x "${FRAMENEST_BACKUP_BIN}" ]; then
  printf '%s\n' "FrameNest export executable is unavailable." >&2
  exit 1
fi

# Minimal root-controlled environment only. Production path defaults match the
# accepted catalog-backup roots; secrets and operator environment are not
# inherited. NOSETENV sudoers must prevent caller environment injection.
export PATH="/usr/bin:/bin"
export PYTHONUNBUFFERED=1
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export HOME="/var/lib/framenest"
export FRAMENEST_DATABASE_PATH="/var/lib/framenest/catalog.sqlite3"
export FRAMENEST_CATALOG_BACKUP_ROOT="/var/lib/framenest/catalog-backups"
export FRAMENEST_CATALOG_RESTORE_VERIFY_ROOT="/var/lib/framenest/catalog-restore-verify"
export FRAMENEST_CATALOG_BACKUP_OPS_ROOT="/var/lib/framenest/catalog-backup-ops"

cd "${FRAMENEST_WORKDIR}"

exec "${FRAMENEST_BACKUP_BIN}" export-latest
