[Unit]
Description=Kronika capture loopback bridge
Documentation=https://github.com/cisarik/framenest
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kronika-capture
Group=kronika-capture
WorkingDirectory=/opt/framenest/capture-current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/kronika-capture/capture.env
ExecStart=/opt/framenest/capture-current/.venv/bin/kronika-capture bridge run --state-dir /var/lib/kronika-capture --port 8765
Restart=on-failure
RestartSec=5s
LoadCredential=token:/etc/kronika-capture/credentials/kronika-bridge-token
StateDirectory=kronika-capture
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
