[Unit]
Description=Daily FrameNest catalog backup and restore verification
Documentation=https://github.com/cisarik/framenest
Requires=framenest-catalog-backup.service

[Timer]
OnCalendar=*-*-* 03:17:00 UTC
Persistent=yes
RandomizedDelaySec=900
AccuracySec=1min
Unit=framenest-catalog-backup.service

[Install]
WantedBy=timers.target
