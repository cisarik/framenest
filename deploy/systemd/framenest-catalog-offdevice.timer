[Unit]
Description=Daily FrameNest off-device catalog backup copy and restore verification
Documentation=https://github.com/cisarik/framenest
Requires=framenest-catalog-offdevice.service

[Timer]
OnCalendar=*-*-* 04:17:00 UTC
Persistent=yes
RandomizedDelaySec=900
AccuracySec=1min
Unit=framenest-catalog-offdevice.service

[Install]
WantedBy=timers.target
