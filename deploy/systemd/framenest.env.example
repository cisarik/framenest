# FrameNest systemd non-secret environment template.
# Copy to /etc/framenest/framenest.env and edit for the target host.
# Do not put API keys, tokens, passwords, cookies, or private keys in this file.

FRAMENEST_HOST=127.0.0.1
FRAMENEST_PORT=8000
FRAMENEST_DATABASE_PATH=/var/lib/framenest/catalog.sqlite3
FRAMENEST_GALLERY_PREVIEW_CACHE_PATH=/var/cache/framenest/gallery-previews
FRAMENEST_AI_CONFIG_PATH=/var/lib/framenest/ai/config.json

# Optional YouTube manual ingestion. This pre-existing private directory must
# remain disjoint from quarantine, cache, database, and registered media roots.
# Enabling it also requires the existing upload quarantine and publication
# destination configuration.
# FRAMENEST_YOUTUBE_ACQUISITION_ROOT=/var/lib/framenest/youtube-acquisition
# FRAMENEST_YOUTUBE_ACQUISITION_MAX_STAGING_BYTES=2214592512

# Optional non-secret server AI selection. Provider credentials belong in the
# future service-secret integration documented as deferred in
# docs/UBUNTU_NUC_DEPLOYMENT.md.
# FRAMENEST_AI_PROVIDER_ID=vercel-ai-gateway
# FRAMENEST_AI_MODEL_ID=google/gemini-3.1-flash-lite

# Optional automatic post-catalog analysis. Disabled by default.
# FRAMENEST_AUTOMATIC_MEDIA_ANALYSIS_ENABLED=false
# Bound provider invocation attempts for one automatic analysis run (1-10).
# FRAMENEST_AUTOMATIC_MEDIA_ANALYSIS_MAX_ATTEMPTS=1

# Optional Tailscale remote-access ingress. When enabled, the application
# stops listening on TCP and binds only this permission-restricted Unix
# socket; the only remote ingress is root-owned Tailscale HTTPS Serve.
# All four keys are required together, the origin must be the exact
# https origin of the tailnet node (no path, no trailing slash), and the
# identity map must name at least one exact login with the "admin" role.
# FRAMENEST_INGRESS_MODE=tailscale_uds
# FRAMENEST_UDS_PATH=/run/framenest/framenest.sock
# FRAMENEST_EXTERNAL_ORIGIN=https://<node>.<tailnet>.ts.net
# FRAMENEST_IDENTITY_MAP={"<login>@<example>":"<admin|user>"}
