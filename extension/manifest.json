{
  "manifest_version": 3,
  "name": "FrameNest X Companion",
  "version": "0.1.0",
  "description": "Save eligible X posts to FrameNest and attach catalog memes to the X composer. Never posts on your behalf.",
  "key": "",
  "permissions": ["sidePanel", "storage"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["https://*.ts.net/*"],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_title": "FrameNest companion",
    "default_popup": "ui/picker.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/picker.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "shared/messages.js",
        "content/x_adapter_contract_v1.js",
        "content/x_adapter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/picker.html", "ui/picker.css", "ui/picker.js", "ui/save.html", "ui/save.css", "ui/save.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
